{
  "schema": "handnavigate.transfer.v1",
  "name": "Daily image transfer",
  "count": 10,
  "new_only": true,
  "source": {
    "url": "https://source.example/images",
    "scope": {
      "origins": [
        "https://source.example"
      ],
      "methods": [
        "GET",
        "HEAD",
        "OPTIONS"
      ],
      "max_actions": 200
    },
    "setup": [],
    "items": "img",
    "image_selector": "",
    "image_attribute": "src",
    "next": {
      "kind": "scroll"
    }
  },
  "target": {
    "url": "https://destination.example/gallery",
    "scope": {
      "origins": [
        "https://destination.example"
      ],
      "methods": [
        "GET",
        "HEAD",
        "OPTIONS",
        "POST"
      ],
      "max_actions": 200
    },
    "setup": [],
    "file_input": {
      "kind": "css",
      "value": "input[type=file]"
    },
    "submit": {
      "kind": "role",
      "role": "button",
      "name": "Upload"
    },
    "verify": {
      "url": "https://destination.example/gallery",
      "items": "img",
      "image_selector": "",
      "image_attribute": "src",
      "id_attribute": "src"
    }
  },
  "limits": {
    "max_bytes": 26214400,
    "max_pixels": 40000000,
    "min_width": 1,
    "min_height": 1,
    "max_pages": 20,
    "max_candidates": 500,
    "timeout_seconds": 900,
    "verify_seconds": 20
  }
}