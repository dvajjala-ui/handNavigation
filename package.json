{
  "name": "handnavigate-desktop",
  "version": "0.9.3",
  "description": "Teach browser workflows once and repeat them locally with verified results.",
  "author": "HandNavigate",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/test/*.test.cjs",
    "test:desktop": "node desktop/test/e2e.cjs && node desktop/test/workflows.cjs && node desktop/test/reliability.cjs && node desktop/test/collections.cjs",
    "test:packaged": "node desktop/test/packaged.cjs",
    "service": "node service/server.cjs",
    "service:login": "node service/login.cjs",
    "test:service": "node --test service/test/*.test.cjs",
    "icons": "node desktop/build-icons.cjs",
    "dist": "npm run icons && electron-builder --win portable --x64",
    "pack": "npm run icons && electron-builder --dir --win --x64"
  },
  "dependencies": { "sharp": "0.35.5", "playwright": "1.64.1", "proper-lockfile": "4.1.2" },
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "com.handnavigate.desktop",
    "productName": "HandNavigate",
    "directories": { "output": "dist", "buildResources": "desktop/assets" },
    "files": ["desktop/**", "service/**", "!desktop/test/**", "!desktop/evidence/**", "!service/test/**", "!service/evidence/**", "!service/*check.cjs", "package.json"],
    "asarUnpack": ["node_modules/sharp/**", "node_modules/@img/**", "node_modules/playwright/**", "node_modules/playwright-core/**"],
    "extraResources": [{"from":"Invoke-HandNavigate.ps1","to":"Invoke-HandNavigate.ps1"}],
    "win": { "target": ["portable"], "icon": "desktop/assets/icon.ico", "signExecutable": false },
    "portable": { "artifactName": "HandNavigate-${version}-Windows.exe" },
    "npmRebuild": false
  }
}
